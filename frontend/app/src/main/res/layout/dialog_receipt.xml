<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_rounded_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Container to capture as bitmap for download & sharing -->
    <LinearLayout
        android:id="@+id/layoutReceiptCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_year_unselected"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Ganpati Logo & Mandal Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivReceiptLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReceiptMandalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚩 श्री गणेश मित्र मंडळ"
                    android:textColor="#C2410C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="गणेशोत्सव - अधिकृत जमा पावती"
                    android:textColor="@color/primary_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E2E8F0" />

        <!-- Receipt No & Date Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvReceiptNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="पावती क्र: REC-2026-1082"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="तारीख: 20 Aug 2026"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Contributor Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="नाव:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvReceiptName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="राम पाटील"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mobile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="मोबाईल:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvReceiptPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9876543210"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Details / Purpose -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="तपशील:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvReceiptDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="गणेशोत्सव वर्गणी"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Big Amount Highlight Box -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#DCFCE7"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="जमा रक्कम:"
                android:textColor="#166534"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="₹ 1,001/-"
                android:textColor="#15803D"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Official Stamp & Blessings Footer -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="🙏 गणपती बाप्पा मोरया!"
                android:textColor="#EA580C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="स्वाक्षरी / शिक्का ✓"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Action Buttons (Download, WhatsApp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <!-- Download Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadReceipt"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="📥 डाऊनलोड"
            android:textColor="@color/primary_blue"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary_blue" />

        <!-- WhatsApp Share Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareReceipt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2"
            android:backgroundTint="#25D366"
            android:text="📲 WhatsApp पावती"
            android:textColor="@color/white"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
