<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Mandal ID Pill -->
            <TextView
                android:id="@+id/tvMandalId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/chip_year_selected"
                android:backgroundTint="#0B5ED7"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="M001"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Status Pill -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/chip_year_unselected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="ACTIVE"
                android:textColor="#166534"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Mandal Name & Logo Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMandalLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_bg"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMandalName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="श्री गणेश मित्र मंडळ"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Address -->
                <TextView
                    android:id="@+id/tvMandalAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 माने/ढेरे वस्ती, बाळेवाडी"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Admin Details Box -->
        <LinearLayout
            android:id="@+id/layoutAdminInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvAdminName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👑 ॲडमिन: राहुल माने"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAdminPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 मोबाईल: 9876543210"
                    android:textColor="#2563EB"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAdminPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FEF3C7"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="🔑 पिन: 1234"
                    android:textColor="#D97706"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#F1F5F9" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditMandal"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✏️ नाव बदला"
                android:textColor="#0B5ED7"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAdmin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="👤 ॲडमिन जोडा"
                android:textColor="#C2410C"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="#C2410C" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
